# ── 账号（必填）───────────────────────────────────────────────
# 在 Await 的「备份与恢复」里填的就是这两项
WEBDAV_USER=await
# 请换成强密码：openssl rand -base64 24
WEBDAV_PASSWORD=

# ── HTTPS（推荐）─────────────────────────────────────────────
# 用 `docker compose --profile https up -d` 时必填：已解析到本机的域名
AWAIT_DOMAIN=dav.example.com
# Let's Encrypt 到期提醒邮箱，可留空
AWAIT_TLS_EMAIL=

# ── 存储与端口 ───────────────────────────────────────────────
# 备份数据在宿主机上的位置
WEBDAV_DATA=./data
# 容器暴露的端口；启用 https profile 时这个端口只给 Caddy 用
WEBDAV_PORT=8080
# 启用 https profile 后建议改成 127.0.0.1，避免明文端口暴露到公网
WEBDAV_BIND=0.0.0.0

# ── 文件属主 ─────────────────────────────────────────────────
# 备份文件在宿主机上的属主，填你的用户 id（id -u / id -g）
PUID=1000
PGID=1000
TZ=Asia/Shanghai
